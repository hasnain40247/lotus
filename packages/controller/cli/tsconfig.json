{
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@gco/schema": ["../../shared/schema/src/index.ts"],
      "@gco/schema/*": ["../../shared/schema/src/*.ts"],
      "@gco/model-domain": ["../../model/domain/src/index.ts"],
      "@gco/model-domain/*": ["../../model/domain/src/*.ts"],
      "@gco/model-firestore": ["../../model/firestore/src/index.ts"],
      "@gco/model-secrets": ["../../model/secrets/src/index.ts"],
      "@gco/model-test": ["../../model/test/src/index.ts"],
      "@gco/cloud": ["../../cloud/src/index.ts"],
      "@gco/cloud/*": ["../../cloud/src/*.ts"],
      "@gco/llm": ["../../shared/llm/src/index.ts"],
      "@gco/llm/route": ["../../shared/llm/src/route/index.ts"],
      "@gco/llm/providers/vertex": ["../../shared/llm/src/providers/vertex.ts"],
      "@gco/llm/providers/*": ["../../shared/llm/src/providers/*.ts"],
      "@gco/controller-session": ["../session/src/index.ts"],
      "@gco/controller-agent": ["../agent/src/index.ts"],
      "@gco/controller-mcp": ["../mcp/src/index.ts"],
      "@gco/controller-tool": ["../tool/src/index.ts"],
      "@gco/view-cli": ["../../view/cli/src/index.ts"],
      "@gco/view-tui": ["../../view/tui/src/index.tsx"],
      "@gco/view-tui/config": ["../../view/tui/src/config/index.tsx"],
      "@gco/view-tui/*": ["../../view/tui/src/*"]
    }
  },
  "include": ["src/**/*"]
}
