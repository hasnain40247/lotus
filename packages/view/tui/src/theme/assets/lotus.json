{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkBg1": "#0d0b18",
    "darkBg2": "#13101f",
    "darkBg3": "#1a162b",
    "darkBg4": "#1f1a33",
    "darkBg5": "#2a2244",
    "darkBg6": "#3d3360",
    "darkBg7": "#6654a0",
    "darkBg8": "#8b7db5",
    "darkPrimary": "#e879a4",
    "darkPrimaryBright": "#f472b6",
    "darkSecondary": "#22d3ee",
    "darkAccent": "#a78bfa",
    "darkText": "#f0e6ff",
    "darkTextMuted": "#8b7db5",
    "darkRed": "#f43f5e",
    "darkOrange": "#fb923c",
    "darkGreen": "#34d399",
    "darkCyan": "#38bdf8",
    "darkYellow": "#fbbf24",
    "lightBg1": "#fdf4ff",
    "lightBg2": "#f9eeff",
    "lightBg3": "#f0e4ff",
    "lightBg4": "#ede0ff",
    "lightBg5": "#d8c8f0",
    "lightBg6": "#c4b0e0",
    "lightBg7": "#9b7dc8",
    "lightBg8": "#7c5fa0",
    "lightPrimary": "#c2185b",
    "lightSecondary": "#0891b2",
    "lightAccent": "#7c3aed",
    "lightText": "#1a0a2e",
    "lightTextMuted": "#7c5fa0",
    "lightRed": "#e11d48",
    "lightOrange": "#d97706",
    "lightGreen": "#059669",
    "lightCyan": "#0284c7",
    "lightYellow": "#b45309"
  },
  "theme": {
    "primary": { "dark": "darkPrimary", "light": "lightPrimary" },
    "secondary": { "dark": "darkSecondary", "light": "lightSecondary" },
    "accent": { "dark": "darkAccent", "light": "lightAccent" },
    "error": { "dark": "darkRed", "light": "lightRed" },
    "warning": { "dark": "darkOrange", "light": "lightOrange" },
    "success": { "dark": "darkGreen", "light": "lightGreen" },
    "info": { "dark": "darkCyan", "light": "lightCyan" },
    "text": { "dark": "darkText", "light": "lightText" },
    "textMuted": { "dark": "darkTextMuted", "light": "lightTextMuted" },
    "background": { "dark": "transparent", "light": "transparent" },
    "backgroundPanel": { "dark": "transparent", "light": "transparent" },
    "backgroundElement": { "dark": "transparent", "light": "transparent" },
    "backgroundMenu": { "dark": "darkBg4", "light": "lightBg4" },
    "border": { "dark": "darkBg6", "light": "lightBg6" },
    "borderActive": { "dark": "darkBg7", "light": "lightBg7" },
    "borderSubtle": { "dark": "darkBg5", "light": "lightBg5" },
    "diffAdded": { "dark": "darkGreen", "light": "lightGreen" },
    "diffRemoved": { "dark": "darkRed", "light": "lightRed" },
    "diffContext": { "dark": "darkAccent", "light": "lightAccent" },
    "diffHunkHeader": { "dark": "darkSecondary", "light": "lightSecondary" },
    "diffHighlightAdded": { "dark": "#6ee7b7", "light": "#34d399" },
    "diffHighlightRemoved": { "dark": "#fb7185", "light": "#e11d48" },
    "diffAddedBg": { "dark": "transparent", "light": "transparent" },
    "diffRemovedBg": { "dark": "transparent", "light": "transparent" },
    "diffContextBg": { "dark": "transparent", "light": "transparent" },
    "diffLineNumber": { "dark": "darkBg8", "light": "lightBg8" },
    "diffAddedLineNumberBg": { "dark": "transparent", "light": "transparent" },
    "diffRemovedLineNumberBg": { "dark": "transparent", "light": "transparent" },
    "markdownText": { "dark": "darkText", "light": "lightText" },
    "markdownHeading": { "dark": "darkPrimary", "light": "lightPrimary" },
    "markdownLink": { "dark": "darkSecondary", "light": "lightSecondary" },
    "markdownLinkText": { "dark": "darkCyan", "light": "lightCyan" },
    "markdownCode": { "dark": "darkGreen", "light": "lightGreen" },
    "markdownBlockQuote": { "dark": "darkAccent", "light": "lightAccent" },
    "markdownEmph": { "dark": "darkAccent", "light": "lightAccent" },
    "markdownStrong": { "dark": "darkPrimary", "light": "lightPrimary" },
    "markdownHorizontalRule": { "dark": "darkBg8", "light": "lightBg8" },
    "markdownListItem": { "dark": "darkPrimary", "light": "lightPrimary" },
    "markdownListEnumeration": { "dark": "darkSecondary", "light": "lightSecondary" },
    "markdownImage": { "dark": "darkSecondary", "light": "lightSecondary" },
    "markdownImageText": { "dark": "darkCyan", "light": "lightCyan" },
    "markdownCodeBlock": { "dark": "darkText", "light": "lightText" },
    "syntaxComment": { "dark": "darkTextMuted", "light": "lightTextMuted" },
    "syntaxKeyword": { "dark": "darkAccent", "light": "lightAccent" },
    "syntaxFunction": { "dark": "darkPrimary", "light": "lightPrimary" },
    "syntaxVariable": { "dark": "darkPrimaryBright", "light": "#ec4899" },
    "syntaxString": { "dark": "darkGreen", "light": "lightGreen" },
    "syntaxNumber": { "dark": "darkOrange", "light": "lightOrange" },
    "syntaxType": { "dark": "darkSecondary", "light": "lightSecondary" },
    "syntaxOperator": { "dark": "darkCyan", "light": "lightCyan" },
    "syntaxPunctuation": { "dark": "darkText", "light": "lightText" }
  }
}
